# Read-only common market catalog (events.unified_options).
COMMON_POSTGRES_URI=postgres://user:pass@127.0.0.1:5432/aimarket

# This service's order/fill/rebalance database.
APP_POSTGRES_URI=postgres://user:pass@127.0.0.1:5432/market_arb

ENABLED_PLATFORMS=polymarket,outcome
ENABLE_BUY=false

# 从 common 库刷新可交易市场、重订 WS 的间隔（秒）
DISCOVERY_INTERVAL_SECS=30
# 轮询未完成腿的成交/状态（秒）
RECONCILE_INTERVAL_SECS=2
# 扫描已完成但仓位不平衡的订单并尝试对冲（秒）
HEDGE_INTERVAL_SECS=5
# 本地超过此时长未收到盘口更新则视为过期，不算套利（毫秒）
BOOK_STALE_MS=5000
# 只对过期的 Polymarket 盘口批量 REST /books 对账（秒，应大于 BOOK_STALE_MS）
BOOK_RESYNC_SECS=10
# 每轮最多拉取的过期 PM token 数（官方 /books 上限 500）
BOOK_RESYNC_BATCH=80
# 单笔套利计划的最低利润（美元）
ARB_MIN_PROFIT=3
# 年化收益率下限；0 表示不按 APR 过滤
ARB_MIN_APR=0
# 单笔套利两腿合计成本上限（美元）
ARB_COST_LIMIT=100
# 手续费估算额外放大倍数，偏保守
ARB_EXTRA_COST_MULTIPLIER=1.3
# 两平台仓位差超过该股数才触发再平衡
MIN_REBALANCE_QTY=1.5
# Polymarket 费率先验（基点）；目录缺少 feeSchedule.rate 时才用，700 = crypto 0.07
POLYMARKET_FEE_BPS_PRIOR=700
# Outcome / Hyperliquid taker 费率
OUTCOME_TAKER_FEE_RATE=0.00035

POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# 50+ 账户写在独立 JSON（相对工作目录），不要塞进本文件。
POLYMARKET_FUNDER_KEYS_FILE=polymarket_funders.json
# 仍可用内联 JSON 覆盖文件（不推荐）：POLYMARKET_FUNDER_PRIVATE_KEYS={"0x..":{"walletPrivateKey":"0x.."}}

HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_EXCHANGE_URL=https://api.hyperliquid.xyz/exchange
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_MAINNET=true
OUTCOME_AGENT_PRIVATE_KEY=
OUTCOME_ACCOUNT_ADDRESS=
